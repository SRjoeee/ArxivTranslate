{
  "name": "arxiv-html-translator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/check-output.mjs",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "fixtures:stats": "tsx scripts/fixtures-stats.ts",
    "icons": "node scripts/icons.mjs",
    "check:output": "node scripts/check-output.mjs",
    "e2e": "node tests/e2e/extension.mjs",
    "e2e:layout": "node tests/e2e/layout.mjs",
    "e2e:a11y": "node tests/e2e/a11y.mjs",
    "e2e:local-endpoint": "node tests/e2e/local-endpoint.mjs",
    "e2e:image": "node tests/e2e/image.mjs",
    "e2e:placeholders": "node tests/e2e/placeholders.mjs",
    "helper:build": "swift build -c release --package-path helper",
    "helper:smoke": "node scripts/helper-smoke.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.13.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.43",
    "ai": "^7.0.91",
    "dexie": "^4.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  }
}
